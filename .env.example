# Variables de entorno de Notarial. Copiar a .env.local para desarrollo local
# (Vite solo carga variables VITE_*) — el resto (ANTHROPIC_API_KEY, SUPABASE_SERVICE_KEY)
# son del backend y se configuran en Vercel → Project Settings → Environment Variables.

# Backend (api/scriba.js, api/vision.js)
ANTHROPIC_API_KEY=

# Backend (api/oo-callback.js) — service role key de Supabase, NUNCA la anon key.
# Nombrada SUPABASE_SERVICE_KEY por convención propia del proyecto (no es el nombre
# que usa Supabase en su propio dashboard, que es SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SERVICE_KEY=

# Frontend — solo usada por el proxy del dev server (vite.config.js), no por el
# build de producción (el editor usa la URL hardcodeada en EditorScreen.jsx).
VITE_ONLYOFFICE_URL=https://onlyoffice.notarial.lat
